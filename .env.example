# Your server's hostname. DNS must point at this machine (ports 80/443 open).
SME_DOMAIN=env.example.com

# Pin a version for predictable upgrades (default: latest)
# SME_VERSION=0.1.2

# Only if you can't use 80/443 (Caddy then can't get a Let's Encrypt cert via HTTP challenge)
# SME_HTTP_PORT=80
# SME_HTTPS_PORT=443

# Full public URL, if it isn't https://$SME_DOMAIN (e.g. a non-standard port)
# SME_BASE_URL=https://env.example.com:8443
